# PostgreSQL connection string. Do not commit real credentials.
#
# Local PostgreSQL example:
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/heritage_mess?schema=public"
#
# Supabase Free direct/session connection example, suitable for Prisma migrations
# and persistent Node runtimes that can reach the database endpoint:
# DATABASE_URL="postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres?sslmode=require"
#
# Supabase Free transaction-pooler example, suitable for serverless-style runtime
# app traffic. Use Supabase's pooler host from the project dashboard.
# DATABASE_URL="postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/heritage_mess?schema=public"

# Optional security tuning. Defaults are intentionally conservative for the MVP.
SESSION_TTL_HOURS="12"
LOGIN_MAX_ATTEMPTS="5"
LOGIN_WINDOW_MINUTES="15"
